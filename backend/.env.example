# Environment ('local' for dev SQLite + offline copilot, 'production' for Catalyst Data Store + QuickML)
ENVIRONMENT=local

# Local SQLite Database (relative paths resolve against the backend/ directory)
DATABASE_URL=sqlite+aiosqlite:///./data/mock_data/mock_fir_data.db

# Vector Index Configuration
FAISS_INDEX_PATH=./data/fir_index.faiss
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Zoho Catalyst QuickML Configuration (Production mode only)
QUICKML_LLM_ENDPOINT=https://quickml.zoho.com/api/v1/llm/completion
QUICKML_OAUTH_TOKEN=your_zoho_oauth_token_here
QUICKML_ORG_ID=your_zoho_org_id_here

# CORS Configuration — JSON list format, e.g. ["http://localhost:5173","https://drishti.example.com"]
CORS_ORIGINS=["*"]
